{
  "expo": {
    "name": "JW Original Song Lyrics",
    "slug": "mobile",
    "version": "1.3.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jworiginalsongslyrics.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.jworiginalsongslyrics.app",
      "versionCode": 9,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class androidx.work.** { *; }\n-keep class androidx.work.impl.** { *; }\n-keep class androidx.work.impl.WorkDatabase { *; }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }\n-keep class * extends androidx.work.impl.WorkDatabase { *; }\n-keep @androidx.room.Database class * extends androidx.room.RoomDatabase { *; }\n-dontwarn androidx.work.**\n-keep public class com.google.android.gms.ads.** { public *; }\n-keep public class com.google.ads.** { public *; }"
          }
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6D28D9"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5615986237010538~5078950678"
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "7f7c824c-9014-473d-ba1c-f8243e4940f1"
      }
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-5615986237010538~5078950678"
  }
}
