      "supportsTablet": true,
      "bundleIdentifier": "com.jworiginalsongslyrics.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/adaptive-icon.png"
